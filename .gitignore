# --- Sorties de build ---
/build/
/.gradle/
/build-nb/
/dist-nb/
/nbproject/private/
# build-impl.xml est REGENERE par NetBeans a l'ouverture ; assets-impl.xml, NON :
# le SDK ne l'ecrit qu'a la CREATION du projet. Absent, l'extension « assets »
# declaree dans project.xml pointe dans le vide et le projet s'ouvre incomplet.
/nbproject/build-impl.xml

# --- ASSETS : aucune donnee du jeu n'est versionnee ---
# Tout assets/ est REGENERE depuis les disquettes :
#   gradle -p rebirth extract     assets d'origine -> PNG/JSON/OBJ/WAV
#   gradle -p rebirth materials   -> assets/materials/*.j3m
#   gradle -p rebirth scenes      -> assets/Scenes/*.j3o
# Seuls les SHADERS sont a nous, donc versionnes.
/assets/*
!/assets/Shaders/

# --- Captures et diagnostics ---
/*.png
*.stackdump

# --- IDE ---
/.idea/
*.iml
